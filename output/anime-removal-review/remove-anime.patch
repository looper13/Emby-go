+
+func TestDirectoryDatabaseOmitsOnlineCatalog(t *testing.T) {
+	s, err := Open(filepath.Join(t.TempDir(), "fresh.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { s.waitFeaturesReady(); s.Close() }()
+	var count int
