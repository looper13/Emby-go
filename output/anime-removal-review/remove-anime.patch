+++ b/internal/server/media_items.go
@@ -0,0 +1,94 @@
+package server
+
+import (
+	"cmp"
+	"database/sql"
+	"fmt"
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+
+	"emby-go/internal/store"
+	"github.com/gin-gonic/gin"
+)
+
+func sortMediaItems(c *gin.Context, items []gin.H) {
+	key := firstSortKey(c.DefaultQuery("SortBy", "SortName"))
+	desc := strings.EqualFold(c.Query("SortOrder"), "Descending")
+	sort.SliceStable(items, func(i, j int) bool {
+		x, y := items[i], items[j]
+		compare := 0
+		switch strings.ToLower(key) {
+		case "productionyear", "communityrating", "indexnumber":
+			field := "ProductionYear"
+			if strings.EqualFold(key, "CommunityRating") {
+				field = "CommunityRating"
+			}
+			if strings.EqualFold(key, "IndexNumber") {
+				field = "IndexNumber"
+			}
+			compare = cmp.Compare(mediaNumber(x[field]), mediaNumber(y[field]))
+		case "datecreated":
+			compare = strings.Compare(fmt.Sprint(x["DateCreated"]), fmt.Sprint(y["DateCreated"]))
+		default:
+			// 同一剧集中的季和章节按数字编号稳定排序。
+			if x["Type"] == y["Type"] && (x["Type"] == "Episode" || x["Type"] == "Season") && x["SeriesId"] == y["SeriesId"] {
+				compare = cmp.Compare(intValue(x["ParentIndexNumber"]), intValue(y["ParentIndexNumber"]))
+				if compare == 0 {
+					compare = cmp.Compare(intValue(x["IndexNumber"]), intValue(y["IndexNumber"]))
+				}
+			} else {
+				compare = strings.Compare(strings.ToLower(fmt.Sprint(x["Name"])), strings.ToLower(fmt.Sprint(y["Name"])))
+			}
+		}
+		if compare == 0 {
+			compare = strings.Compare(fmt.Sprint(x["Id"]), fmt.Sprint(y["Id"]))
+		}
+		if desc {
+			return compare > 0
+		}
+		return compare < 0
+	})
+}
+func mediaNumber(v any) float64 {
+	if n, ok := v.(float64); ok {
+		return n
+	}
+	return float64(intValue(v))
+}
+func mediaPageWindow(c *gin.Context) (int, int) {
+	start, _ := strconv.Atoi(c.Query("StartIndex"))
+	start = max(0, start)
+	limit, _ := strconv.Atoi(c.DefaultQuery("Limit", "100"))
+	if limit < 1 || limit > 1000 {
+		limit = 100
+	}
+	return start, limit
+}
+func writeMediaItems(c *gin.Context, items []gin.H, total int) {
+	start, limit := mediaPageWindow(c)
+	from := min(start, len(items))
+	to := from + min(limit, len(items)-from)
+	c.JSON(http.StatusOK, gin.H{"Items": items[from:to], "TotalRecordCount": total, "StartIndex": start})
+}
+
+func intValue(v any) int {
+	switch n := v.(type) {
+	case int:
+		return n
+	case int64:
+		return int(n)
+	case float64:
+		return int(n)
+	}
+	return 0
+}
+
+func (a *App) resolveUserMedia(raw string) (store.Movie, error) {
+	m, _, _, ok := a.resolvePlaybackTarget(raw)
+	if !ok || !m.IsVisible() {
+		return store.Movie{}, sql.ErrNoRows
+	}
+	return m, nil
+}
diff --git a/internal/store/catalog_removal.go b/internal/store/catalog_removal.go
new file mode 100644
--- /dev/null
+++ b/internal/store/catalog_removal.go
@@ -0,0 +1,68 @@
+package store
+
+import (
+	"context"
+	"fmt"
+)
+
+// migrateDirectoryLibraries 只补齐普通媒体库字段，旧动漫结构由用户手动清理。
+func (s *Store) migrateDirectoryLibraries() error {
+	ctx := context.Background()
+	conn, err := s.db.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	tx, err := conn.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	// 先占用写锁，避免已有后台写入使读取后的 WAL 快照无法升级为写事务。
+	if _, err = tx.ExecContext(ctx, `UPDATE schema_migrations SET version=version WHERE version=5`); err != nil {
+		return err
+	}
+	columns := map[string]bool{}
+	rows, err := tx.QueryContext(ctx, `PRAGMA table_info(libraries)`)
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var cid, notNull, primaryKey int
+		var name, columnType string
+		var defaultValue any
+		if err = rows.Scan(&cid, &name, &columnType, &notNull, &defaultValue, &primaryKey); err != nil {
+			rows.Close()
+			return err
+		}
+		columns[name] = true
+	}
+	readErr := rows.Err()
+	rows.Close()
+	if readErr != nil {
+		return readErr
+	}
+	var hasCatalog bool
+	if err = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name GLOB 'anime_*')`).Scan(&hasCatalog); err != nil {
+		return err
+	}
+	if columns["system_key"] || hasCatalog {
+		return fmt.Errorf("数据库仍有在线动漫结构；请停止服务并备份后，手动执行 scripts/remove_anime.sql，再启动新版")
+	}
+	// 动漫功能加入前的数据库也需要普通媒体库的修订号和代理开关。
+	for _, column := range []struct{ name, definition string }{
+		{"source_type", "TEXT NOT NULL DEFAULT 'nfo_directory'"},
+		{"revision", "INTEGER NOT NULL DEFAULT 1"},
+		{"proxy_enabled", "INTEGER NOT NULL DEFAULT 0 CHECK(proxy_enabled IN (0,1))"},
+	} {
+		if !columns[column.name] {
+			if _, err = tx.ExecContext(ctx, "ALTER TABLE libraries ADD COLUMN "+column.name+" "+column.definition); err != nil {
+				return err
+			}
+		}
+	}
+	if _, err = tx.ExecContext(ctx, `INSERT OR IGNORE INTO schema_migrations(version) VALUES(5)`); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
