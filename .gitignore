# Build artifacts
/metatube.exe
/metatube
*.exe
*.exe~
/dist/

# Vue source is tracked; generated output and browser evidence are not.
/frontend/node_modules/
/frontend/dist/
/frontend/.ui-build.lock/
/frontend/playwright-report/
/frontend/test-results/
/internal/server/web_dist/
/internal/server/web_dist.next/
/internal/server/web_dist.previous/
/vue-migration/screenshots/
/vue-migration/artifacts/

# 第三方参考源码（体积大，不随仓库同步）
/src/

# 内部文档（含真实服务校准记录，不入库）
/docs/

# Runtime data (SQLite WAL/shm 一并忽略)
*.db
*.db-shm
*.db-wal

# Local config（私人配置不入库，示例见 config.example.yaml）
/config.yaml
/config.local.yaml

# 运行日志（log/ 下按天切分的 app-*.log / request-*.log）
*.log
/log/

# Editors / OS
/.idea/
.vscode/
.DS_Store
Thumbs.db
