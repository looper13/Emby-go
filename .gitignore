# Build artifacts
/metatube.exe
/metatube
*.exe
*.exe~
/dist/

# Vue source is tracked; generated output and browser evidence are not.
/frontend/node_modules/
/frontend/dist/
/frontend/.ui-build.lock/
/frontend/playwright-report/
/frontend/test-results/
/.playwright-cli/
/frontend/.playwright-cli/
/output/playwright/
/internal/server/web_dist/
/internal/server/web_dist.next/
/internal/server/web_dist.previous/

# 第三方参考源码（体积大，不随仓库同步）
/src/

# 内部文档（含真实服务校准记录，不入库）
/docs/**
# 项目级 Markdown 文档统一存放于 docs/；内部子目录继续保持忽略。
!/docs/*.md
!/docs/analysis/
!/docs/analysis/project-overview.md
!/docs/analysis/module-inventory.md
!/docs/analysis/risk-assessment.md
!/docs/plan/
!/docs/plan/task-breakdown.md
!/docs/plan/dependency-graph.md
!/docs/plan/milestones.md
!/docs/progress/
!/docs/progress/MASTER.md
!/docs/progress/phase-1-catalog.md
!/docs/progress/phase-2-images.md
!/docs/progress/phase-3-tmdb.md
!/docs/progress/phase-4-validation.md

# Runtime data (SQLite WAL/shm 一并忽略)
/actors/
/avatars/
/anime-catalog/
/anime-images/
/.work-cache/
*.db
*.db-shm
*.db-wal

# Local config（私人配置不入库，示例见 config.example.yaml）
/config.yaml
/config.local.yaml
/anime-tmdb.local.yaml

# 运行日志（log/ 下按天切分的 app-*.log / request-*.log）
*.log
/log/

# Editors / OS
/.idea/
.vscode/
.DS_Store
Thumbs.db
.115.key
